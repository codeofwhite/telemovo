# Optional shell environment: copy to ignored .env, edit, then source explicitly.
# Values below are examples; no machine-specific account or IP is assumed.
export TELEMOVO_SIM_PYTHON=python3
export TELEMOVO_GATEWAY_PYTHON=python3
export TELEMOVO_GPU=0
export TELEMOVO_EGL_DEVICE=0
export TELEMOVO_BIND=127.0.0.1
# Set to your LAN IPv4 address to permit access from PICO.
# export TELEMOVO_BIND=192.168.1.100
# Leave SSH unset when simulation and gateway run on the same machine.
# export TELEMOVO_SSH_HOST=my-gpu-server
# export TELEMOVO_GENESIS_PATH=/absolute/path/to/isolated/genesis-contact
# export TELEMOVO_CERT=/absolute/path/to/server.crt
# export TELEMOVO_KEY=/absolute/path/to/server.key
